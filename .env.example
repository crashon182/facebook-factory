# ───── Base de datos ─────
DATABASE_URL="mysql://ff_user:ff_dev_password@127.0.0.1:3317/facebook_factory"

# ───── Redis (Fase 5: BullMQ) ─────
REDIS_URL="redis://127.0.0.1:6381"

# ───── Auth.js ─────  (generar: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# URL pública de la app
AUTH_URL="http://localhost:3000"

# ───── Cifrado de tokens (AES-256-GCM, clave de 32 bytes en base64) ─────
# generar: openssl rand -base64 32
ENCRYPTION_KEY=""

# ───── Administrador inicial (lo usa `npm run db:seed`) ─────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"

# ───── Integraciones (opcionales hasta su fase; sin ellas quedan "no configuradas") ─────
OPENAI_API_KEY=""
OPENAI_MODEL=""
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
META_APP_ID=""
META_APP_SECRET=""
# Versión de Graph API (por defecto v27.0). Ver docs/META.md
META_GRAPH_VERSION=""
# Opcional: reemplaza los permisos solicitados (separados por coma)
META_SCOPES=""
META_WEBHOOK_VERIFY_TOKEN=""
# Narración: por defecto "openai" (reutiliza OPENAI_API_KEY)
TTS_PROVIDER=""
TTS_MODEL=""
TTS_VOICE=""
# Multimedia
# Proveedor por defecto para los Reels: "pexels" o "pixabay" (vacío = el primero configurado)
MEDIA_PROVIDER=""
# Hosts extra permitidos para descargas, separados por coma (si Pexels sirve videos desde otro dominio)
MEDIA_EXTRA_ALLOWED_HOSTS=""

# ───── Almacenamiento ─────
STORAGE_DIR="./storage"

# ───── Costos de OpenAI (USD por 1M de tokens; sacarlos de la página de precios del modelo elegido) ─────
# Sin precios, el uso se registra en tokens pero el costo queda en 0 y se marca como "no estimado".
OPENAI_PRICE_INPUT_PER_1M=""
OPENAI_PRICE_OUTPUT_PER_1M=""
# Tope global diario (USD) para todas las páginas; vacío = sin tope global
OPENAI_DAILY_LIMIT_USD=""

# ───── Video (Fase 3) ─────
FFMPEG_PATH=""
FFPROBE_PATH=""
FONT_DIR="/usr/share/fonts/truetype/dejavu"
FONT_BOLD=""
FONT_SERIF=""
RENDER_CONCURRENCY="1"
PUBLISH_CONCURRENCY="2"
