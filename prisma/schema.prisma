// Facebook Factory — esquema completo (todas las fases).
// Fechas en UTC; la zona horaria de presentación vive en SocialPage.timezone.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ───────────── Enums ─────────────

enum UserRole {
  ADMIN
}

enum ConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  EXPIRED
  ERROR
}

enum StrategyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StrategySource {
  AI
  MANUAL
}

enum ContentFormat {
  TEXT
  IMAGE
  QUOTE_IMAGE
  REEL
  REFLECTION
  EDUCATIONAL
  INSPIRATIONAL
  SHORT_STORY
}

enum PostStatus {
  DRAFT
  GENERATING
  READY
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum IdeaStatus {
  NEW
  USED
  DISCARDED
}

enum MediaType {
  PHOTO
  VIDEO
  AUDIO
  RENDERED_IMAGE
  RENDERED_VIDEO
  THUMBNAIL
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
  RECONCILING
}

enum ReportType {
  WEEKLY
  PAGE_ANALYSIS
  STRATEGY_REVIEW
}

enum ExperimentStatus {
  PROPOSED
  RUNNING
  COMPLETED
  REVERTED
  REJECTED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

// ───────────── Usuarios ─────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ───────────── Páginas ─────────────

model SocialPage {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  description     String  @db.Text
  topic           String
  targetAudience  String? @db.Text
  language        String  @default("es")
  targetCountry   String?
  timezone        String  @default("America/Argentina/Buenos_Aires")
  tone            String?
  growthGoals     String? @db.Text
  profileImageUrl String? @db.VarChar(1024)
  visualIdentity  String? @db.Text
  primaryColor    String? @db.VarChar(9)
  secondaryColor  String? @db.VarChar(9)
  isActive        Boolean @default(true)

  facebookPageId   String?          @unique
  connectionStatus ConnectionStatus @default(NOT_CONNECTED)
  // Token cifrado con AES-256-GCM (ver src/lib/crypto.ts). Nunca en texto plano.
  accessTokenEnc   String?          @db.Text
  tokenExpiresAt   DateTime?
  connectedAt      DateTime?
  facebookPageName String?
  lastCheckedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strategies   PageStrategy[]
  pillars      ContentPillar[]
  ideas        ContentIdea[]
  posts        ContentPost[]
  schedules    PublicationSchedule[]
  postMetrics  PostMetric[]
  pageMetrics  PageMetric[]
  reports      AIAnalysisReport[]
  experiments  OptimizationExperiment[]
  automation   AutomationRule?
  usageLogs    APIUsageLog[]
  activityLogs ActivityLog[]
  mediaAssets  MediaAsset[]

  @@index([isActive])
  @@index([connectionStatus])
}

model PageStrategy {
  id        String         @id @default(cuid())
  pageId    String
  version   Int
  status    StrategyStatus @default(DRAFT)
  source    StrategySource @default(AI)
  // Estrategia estructurada validada con Zod (ver src/lib/validation/strategy.ts)
  data      Json
  model     String?
  notes     String?        @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  page SocialPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId, status])
}

model ContentPillar {
  id          String   @id @default(cuid())
  pageId      String
  name        String
  description String?  @db.Text
  keywords    Json?
  weight      Int      @default(1)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  page  SocialPage    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  ideas ContentIdea[]
  posts ContentPost[]

  @@unique([pageId, name])
}

model ContentIdea {
  id        String        @id @default(cuid())
  pageId    String
  pillarId  String?
  title     String
  summary   String?       @db.Text
  format    ContentFormat @default(TEXT)
  status    IdeaStatus    @default(NEW)
  createdAt DateTime      @default(now())

  page   SocialPage     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pillar ContentPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  posts  ContentPost[]

  @@index([pageId, status])
}

model ContentPost {
  id              String        @id @default(cuid())
  pageId          String
  ideaId          String?
  pillarId        String?
  internalTitle   String
  topic           String?
  format          ContentFormat
  body            String?       @db.Text
  facebookCaption String?       @db.Text
  script          String?       @db.Text
  imageText       String?       @db.Text
  imageKeywords   Json?
  mediaAssetId    String? // foto principal (formato IMAGE)
  autoGenerated   Boolean       @default(false)
  hashtags        Json?
  status          PostStatus    @default(DRAFT)
  approved        Boolean       @default(false)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  facebookPostId  String?
  failureReason   String?       @db.Text
  contentHash     String?       @db.VarChar(64)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  page        SocialPage           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  idea        ContentIdea?         @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  pillar      ContentPillar?       @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  scenes      ContentScene[]
  mediaAssets MediaAsset[]         @relation("PostAssets")
  mediaAsset  MediaAsset?          @relation("PostPrimaryMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  renderJobs  VideoRenderJob[]
  schedule    PublicationSchedule?
  metrics     PostMetric[]

  @@index([pageId, status])
  @@index([status, scheduledAt])
  @@index([pageId, contentHash])
}

model ContentScene {
  id             String  @id @default(cuid())
  postId         String
  sceneOrder     Int
  narration      String  @db.Text
  visualKeywords Json?
  durationMs     Int?
  mediaAssetId   String?

  post       ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@unique([postId, sceneOrder])
}

model MediaAsset {
  id         String    @id @default(cuid())
  pageId     String?
  postId     String?
  type       MediaType
  provider   String // pexels | local | ...
  externalId String?
  sourceUrl  String?   @db.VarChar(1024)
  localPath  String?   @db.VarChar(1024)
  author     String?
  authorUrl  String?   @db.VarChar(1024)
  license    String?   @db.Text
  width      Int?
  height     Int?
  durationMs Int?
  checksum   String?   @db.VarChar(64)
  title      String?
  keywords   Json?
  mimeType   String?
  sizeBytes  Int?
  thumbPath  String?   @db.VarChar(1024)
  createdAt  DateTime  @default(now())

  page       SocialPage?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  post       ContentPost?   @relation("PostAssets", fields: [postId], references: [id], onDelete: SetNull)
  primaryFor ContentPost[]  @relation("PostPrimaryMedia")
  scenes     ContentScene[]

  @@unique([provider, externalId, type])
  @@index([checksum])
}

model VideoRenderJob {
  id            String    @id @default(cuid())
  postId        String
  status        JobStatus @default(QUEUED)
  progress      Int       @default(0)
  durationSec   Int       @default(30)
  options       Json?
  stage         String?
  outputPath    String?   @db.VarChar(1024)
  thumbnailPath String?   @db.VarChar(1024)
  logs          String?   @db.LongText
  attempts      Int       @default(0)
  error         String?   @db.Text
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  post ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status])
}

// ───────────── Publicación ─────────────

model PublicationSchedule {
  id             String     @id @default(cuid())
  pageId         String
  postId         String     @unique
  scheduledAt    DateTime
  status         PostStatus @default(SCHEDULED)
  // Garantiza que un mismo contenido/horario no se publique dos veces
  idempotencyKey String     @unique
  // No reintentar antes de esta fecha (backoff); null = sin espera
  nextAttemptAt  DateTime?
  lastError      String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  page     SocialPage           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  post     ContentPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  attempts PublicationAttempt[]

  @@index([status, scheduledAt])
  @@index([pageId, scheduledAt])
}

model PublicationAttempt {
  id               String        @id @default(cuid())
  scheduleId       String
  attemptNo        Int
  status           AttemptStatus @default(STARTED)
  facebookObjectId String?
  errorCode        String?
  errorMessage     String?       @db.Text
  response         Json?
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?

  schedule PublicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, attemptNo])
}

// ───────────── Analíticas ─────────────

model PostMetric {
  id           String   @id @default(cuid())
  postId       String
  pageId       String
  capturedAt   DateTime @default(now())
  reach        Int?
  impressions  Int?
  views        Int?
  watchTimeSec Int?
  retention    Float?
  reactions    Int?
  comments     Int?
  shares       Int?
  engagements  Int?
  raw          Json?

  post ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  page SocialPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([postId, capturedAt])
  @@index([pageId, capturedAt])
}

model PageMetric {
  id          String   @id @default(cuid())
  pageId      String
  capturedAt  DateTime @default(now())
  followers   Int?
  reach       Int?
  impressions Int?
  engagements Int?
  raw         Json?

  page SocialPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, capturedAt])
}

model AIAnalysisReport {
  id          String     @id @default(cuid())
  pageId      String?
  type        ReportType
  periodStart DateTime?
  periodEnd   DateTime?
  summary     String     @db.Text
  data        Json?
  createdAt   DateTime   @default(now())

  page SocialPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, type, createdAt])
}

model OptimizationExperiment {
  id         String           @id @default(cuid())
  pageId     String
  hypothesis String           @db.Text
  variable   String
  status     ExperimentStatus @default(PROPOSED)
  startsAt   DateTime?
  endsAt     DateTime?
  result     Json?
  revertedAt DateTime?
  createdAt  DateTime         @default(now())

  page SocialPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, status])
}

// ───────────── Automatización y sistema ─────────────

model AutomationRule {
  id                    String    @id @default(cuid())
  pageId                String    @unique
  enabled               Boolean   @default(false)
  maxPostsPerDay        Int       @default(1)
  allowedFormats        Json?
  publishDays           Json? // [0..6], 0 = domingo
  windowStart           String    @default("09:00") @db.VarChar(5)
  windowEnd             String    @default("21:00") @db.VarChar(5)
  generationFrequency   String    @default("DAILY") @db.VarChar(16)
  requireApproval       Boolean   @default(true)
  autoPublish           Boolean   @default(false)
  autoOptimizeTimes     Boolean   @default(false)
  daysAhead             Int       @default(3)
  dailyBudgetUsd        Decimal   @default(1.00) @db.Decimal(10, 2)
  editorialRestrictions String?   @db.Text
  // Estado del motor de automatización
  lastRunAt             DateTime?
  lastGeneratedAt       DateTime?
  lastRunSummary        Json?
  lockedUntil           DateTime? // bloqueo por página: evita corridas simultáneas entre instancias
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  page SocialPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model APIUsageLog {
  id           String   @id @default(cuid())
  pageId       String?
  provider     String // openai | pexels | meta | tts
  operation    String
  model        String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal  @default(0) @db.Decimal(12, 6)
  success      Boolean  @default(true)
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  page SocialPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
  @@index([pageId, createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  pageId    String?
  level     LogLevel @default(INFO)
  action    String
  message   String   @db.Text
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  page SocialPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([pageId, createdAt])
}
